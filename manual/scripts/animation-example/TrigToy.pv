from math import sin, radians
size(300, 300)
speed(50)

def draw():
    background(0, .25,.25)
    with pen(0.5), stroke(.5, 1, 0), nofill():
        for i in range(30):
            rotate(12)
            v = sin(radians(FRAME)) * i * 20
            with bezier(150, 150):
                curveto(v, -v, v, v, 200, 200)

