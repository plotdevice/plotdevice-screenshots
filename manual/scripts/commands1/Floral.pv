size(400, 400)

def flower(x, y):
    clr = color(random(.5, 1), 0, random(.5))
        
    with fill(clr), stroke(.2), pen(1):
        with transform(CORNER):
            translate(x,y)
            for i in range(10):
                rotate(36)
                line(0,0, 15,15)
                oval(10,10, 10,10)

for i in range(60):
    flower(random(WIDTH), random(HEIGHT))
